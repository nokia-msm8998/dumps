				linux,pci-domain = <0x01>;
				clocks = <0x12 0xb9 0x12 0xb8 0x12 0xb7 0x12 0xb6 0x12 0xb5>;
				clock-names = "pipe\0aux\0cfg\0bus_master\0bus_slave";
