				phandle = <0x3c>;
			};

			hstx_trim@24f {
				reg = <0x24f 0x01>;
				bits = <0x01 0x04>;
				phandle = <0x3d>;
			};
		};

		phy@34000 {
			compatible = "qcom,msm8996-qmp-pcie-phy";
			reg = <0x34000 0x488>;
			#clock-cells = <0x01>;
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			ranges;
			clocks = <0x12 0xc0 0x12 0xbf 0x12 0xd8>;
			clock-names = "aux\0cfg_ahb\0ref";
			vdda-phy-supply = <0x33>;
			vdda-pll-supply = <0x34>;
			resets = <0x12 0x55 0x12 0x65 0x12 0x66>;
			reset-names = "phy\0common\0cfg";
