						phandle = <0x6d>;
					};
				};
			};
		};

		etr@826000 {
			compatible = "arm,coresight-tmc\0arm,primecell";
			reg = <0x826000 0x1000>;
			clocks = <0x27 0x08 0x27 0x09>;
			clock-names = "apb_pclk\0atclk";

			port {

				endpoint {
					slave-mode;
					remote-endpoint = <0x70>;
					phandle = <0x6b>;
				};
			};
		};

		funnel@841000 {
			compatible = "arm,coresight-funnel\0arm,primecell";
			reg = <0x841000 0x1000>;
			clocks = <0x27 0x08 0x27 0x09>;
			clock-names = "apb_pclk\0atclk";

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@0 {
					reg = <0x00>;

					endpoint {
						slave-mode;
						remote-endpoint = <0x71>;
						phandle = <0x79>;
					};
				};

				port@1 {
					reg = <0x01>;

					endpoint {
						slave-mode;
						remote-endpoint = <0x72>;
						phandle = <0x7a>;
					};
				};

				port@2 {
					reg = <0x02>;

					endpoint {
						slave-mode;
						remote-endpoint = <0x73>;
						phandle = <0x7b>;
					};
				};

				port@3 {
					reg = <0x03>;

					endpoint {
						slave-mode;
						remote-endpoint = <0x74>;
						phandle = <0x7c>;
					};
				};

				port@4 {
					reg = <0x00>;

					endpoint {
						remote-endpoint = <0x75>;
						phandle = <0x69>;
					};
				};
			};
		};

		debug@850000 {
			compatible = "arm,coresight-cpu-debug\0arm,primecell";
			reg = <0x850000 0x1000>;
			clocks = <0x27 0x08>;
			clock-names = "apb_pclk";
			cpu = <0x08>;
		};

		debug@852000 {
			compatible = "arm,coresight-cpu-debug\0arm,primecell";
			reg = <0x852000 0x1000>;
			clocks = <0x27 0x08>;
			clock-names = "apb_pclk";
			cpu = <0x76>;
		};

		debug@854000 {
			compatible = "arm,coresight-cpu-debug\0arm,primecell";
			reg = <0x854000 0x1000>;
			clocks = <0x27 0x08>;
			clock-names = "apb_pclk";
			cpu = <0x77>;
		};

		debug@856000 {
			compatible = "arm,coresight-cpu-debug\0arm,primecell";
			reg = <0x856000 0x1000>;
			clocks = <0x27 0x08>;
			clock-names = "apb_pclk";
			cpu = <0x78>;
		};

		etm@85c000 {
			compatible = "arm,coresight-etm4x\0arm,primecell";
			reg = <0x85c000 0x1000>;
			clocks = <0x27 0x08 0x27 0x09>;
			clock-names = "apb_pclk\0atclk";
			cpu = <0x08>;

			port {

				endpoint {
					remote-endpoint = <0x79>;
					phandle = <0x71>;
				};
			};
		};

		etm@85d000 {
			compatible = "arm,coresight-etm4x\0arm,primecell";
			reg = <0x85d000 0x1000>;
			clocks = <0x27 0x08 0x27 0x09>;
			clock-names = "apb_pclk\0atclk";
			cpu = <0x76>;

			port {

				endpoint {
					remote-endpoint = <0x7a>;
					phandle = <0x72>;
				};
			};
		};

		etm@85e000 {
			compatible = "arm,coresight-etm4x\0arm,primecell";
			reg = <0x85e000 0x1000>;
			clocks = <0x27 0x08 0x27 0x09>;
			clock-names = "apb_pclk\0atclk";
			cpu = <0x77>;

			port {

				endpoint {
					remote-endpoint = <0x7b>;
					phandle = <0x73>;
				};
			};
		};

		etm@85f000 {
			compatible = "arm,coresight-etm4x\0arm,primecell";
			reg = <0x85f000 0x1000>;
			clocks = <0x27 0x08 0x27 0x09>;
			clock-names = "apb_pclk\0atclk";
			cpu = <0x78>;

			port {

				endpoint {
					remote-endpoint = <0x7c>;
					phandle = <0x74>;
				};
			};
		};

		video-codec@1d00000 {
			compatible = "qcom,msm8916-venus";
			reg = <0x1d00000 0xff000>;
			interrupts = <0x00 0x2c 0x04>;
			power-domains = <0x0d 0x01>;
			clocks = <0x0d 0x89 0x0d 0x87 0x0d 0x88>;
			clock-names = "core\0iface\0bus";
			iommus = <0x53 0x05>;
			memory-region = <0x7d>;
			status = "okay";

			video-decoder {
				compatible = "venus-decoder";
			};

			video-encoder {
				compatible = "venus-encoder";
			};
		};

		leds {
			pinctrl-names = "default";
			pinctrl-0 = <0x7e 0x7f 0x80>;
			compatible = "gpio-leds";

			led@1 {
				label = "apq8016-sbc:green:user1";
				gpios = <0x26 0x15 0x00>;
				linux,default-trigger = "heartbeat";
				default-state = "off";
			};

			led@2 {
				label = "apq8016-sbc:green:user2";
				gpios = <0x26 0x78 0x00>;
				linux,default-trigger = "mmc0";
				default-state = "off";
			};

			led@3 {
				label = "apq8016-sbc:green:user3";
				gpios = <0x81 0x01 0x00>;
				linux,default-trigger = "mmc1";
				default-state = "off";
			};

			led@4 {
				label = "apq8016-sbc:green:user4";
				gpios = <0x81 0x02 0x00>;
				linux,default-trigger = "none";
				panic-indicator;
				default-state = "off";
			};

			led@5 {
				label = "apq8016-sbc:yellow:wlan";
				gpios = <0x82 0x02 0x00>;
				linux,default-trigger = "phy0tx";
				default-state = "off";
			};

			led@6 {
				label = "apq8016-sbc:blue:bt";
				gpios = <0x82 0x03 0x00>;
				linux,default-trigger = "bluetooth-power";
				default-state = "off";
			};
		};

		sound {
			compatible = "qcom,apq8016-sbc-sndcard";
			reg = <0x7702000 0x04 0x7702004 0x04>;
			reg-names = "mic-iomux\0spkr-iomux";
			status = "okay";
			pinctrl-0 = <0x83 0x84 0x85>;
			pinctrl-1 = <0x86 0x87 0x88>;
			pinctrl-names = "default\0sleep";
			qcom,model = "DB410c";
			qcom,audio-routing = "AMIC2\0MIC BIAS Internal2\0AMIC3\0MIC BIAS External1";

			external-dai-link@0 {
				link-name = "ADV7533";

				cpu {
					sound-dai = <0x89 0x03>;
				};

				codec {
					sound-dai = <0x8a 0x00>;
				};
			};

			internal-codec-playback-dai-link@0 {
				link-name = "WCD";

				cpu {
					sound-dai = <0x89 0x00>;
				};

				codec {
					sound-dai = <0x8b 0x00 0x8c 0x00>;
				};
			};

			internal-codec-capture-dai-link@0 {
				link-name = "WCD-Capture";

				cpu {
					sound-dai = <0x89 0x02>;
				};

				codec {
					sound-dai = <0x8b 0x01 0x8c 0x01>;
				};
			};
		};
	};

	smd {
		compatible = "qcom,smd";

		rpm {
			interrupts = <0x00 0xa8 0x01>;
			qcom,ipc = <0x04 0x08 0x00>;
			qcom,smd-edge = <0x0f>;

			rpm_requests {
				compatible = "qcom,rpm-msm8916";
				qcom,smd-channels = "rpm_requests";

				qcom,rpmcc {
					compatible = "qcom,rpmcc-msm8916";
					#clock-cells = <0x01>;
					phandle = <0x27>;
				};

				pm8916-regulators {
					compatible = "qcom,rpm-pm8916-regulators";
					vdd_l1_l2_l3-supply = <0x64>;
					vdd_l5-supply = <0x64>;
					vdd_l4_l5_l6-supply = <0x8d>;
					vdd_l7-supply = <0x8d>;

					s1 {
						regulator-min-microvolt = <0x5b8d8>;
						regulator-max-microvolt = <0x17d590>;
						phandle = <0x5c>;
					};

					s3 {
						regulator-min-microvolt = <0x5b8d8>;
						regulator-max-microvolt = <0x17d590>;
						phandle = <0x64>;
					};

					s4 {
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x1b7740>;
						regulator-always-on;
						regulator-boot-on;
						phandle = <0x8d>;
					};

					l1 {
						regulator-min-microvolt = <0x5b8d8>;
						regulator-max-microvolt = <0x174508>;
					};

					l2 {
						regulator-min-microvolt = <0x124f80>;
						regulator-max-microvolt = <0x124f80>;
						phandle = <0x56>;
					};

					l3 {
						regulator-min-microvolt = <0x5b8d8>;
						regulator-max-microvolt = <0x174508>;
						phandle = <0x5d>;
					};

					l4 {
						regulator-min-microvolt = <0x1ab3f0>;
						regulator-max-microvolt = <0x32eb28>;
					};

					l5 {
						regulator-min-microvolt = <0x1ab3f0>;
						regulator-max-microvolt = <0x32eb28>;
						phandle = <0x34>;
					};

					l6 {
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x1b7740>;
						phandle = <0x28>;
					};

					l7 {
						regulator-min-microvolt = <0x1ab3f0>;
						regulator-max-microvolt = <0x32eb28>;
						phandle = <0x49>;
					};

					l8 {
						regulator-min-microvolt = <0x1ab3f0>;
						regulator-max-microvolt = <0x32eb28>;
						phandle = <0x33>;
					};

					l9 {
						regulator-min-microvolt = <0x1ab3f0>;
						regulator-max-microvolt = <0x32eb28>;
						phandle = <0x65>;
					};

					l10 {
						regulator-min-microvolt = <0x1ab3f0>;
						regulator-max-microvolt = <0x32eb28>;
					};

					l11 {
						regulator-min-microvolt = <0x1ab3f0>;
						regulator-max-microvolt = <0x32eb28>;
						regulator-allow-set-load;
						regulator-system-load = <0x30d40>;
						phandle = <0x3b>;
					};

					l12 {
						regulator-min-microvolt = <0x1ab3f0>;
						regulator-max-microvolt = <0x32eb28>;
						phandle = <0x3c>;
					};

					l13 {
						regulator-min-microvolt = <0x1ab3f0>;
						regulator-max-microvolt = <0x32eb28>;
						phandle = <0x4a>;
					};

					l14 {
						regulator-min-microvolt = <0x1ab3f0>;
						regulator-max-microvolt = <0x32eb28>;
					};

					l15 {
						regulator-min-microvolt = <0x1ab3f0>;
						regulator-max-microvolt = <0x32eb28>;
						regulator-always-on;
					};

					l16 {
						regulator-min-microvolt = <0x1ab3f0>;
						regulator-max-microvolt = <0x32eb28>;
					};

					l17 {
						regulator-min-microvolt = <0x325aa0>;
						regulator-max-microvolt = <0x325aa0>;
						phandle = <0x29>;
					};

					l18 {
						regulator-min-microvolt = <0x1ab3f0>;
						regulator-max-microvolt = <0x32eb28>;
					};
				};
			};
		};
	};

	hexagon-smp2p {
		compatible = "qcom,smp2p";
		qcom,smem = <0x1b3 0x1ac>;
		interrupts = <0x00 0x1b 0x01>;
		qcom,ipc = <0x04 0x08 0x0e>;
		qcom,local-pid = <0x00>;
		qcom,remote-pid = <0x01>;

		master-kernel {
			qcom,entry-name = "master-kernel";
			#qcom,smem-state-cells = <0x01>;
			phandle = <0x5a>;
		};

		slave-kernel {
			qcom,entry-name = "slave-kernel";
			interrupt-controller;
			#interrupt-cells = <0x02>;
			phandle = <0x59>;
		};
	};

	wcnss-smp2p {
		compatible = "qcom,smp2p";
		qcom,smem = <0x1c3 0x1af>;
		interrupts = <0x00 0x8f 0x01>;
		qcom,ipc = <0x04 0x08 0x12>;
		qcom,local-pid = <0x00>;
		qcom,remote-pid = <0x04>;

		master-kernel {
			qcom,entry-name = "master-kernel";
			#qcom,smem-state-cells = <0x01>;
			phandle = <0x62>;
		};

		slave-kernel {
			qcom,entry-name = "slave-kernel";
			interrupt-controller;
			#interrupt-cells = <0x02>;
			phandle = <0x61>;
		};
	};

	smsm {
		compatible = "qcom,smsm";
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		qcom,ipc-1 = <0x04 0x08 0x0d>;
		qcom,ipc-3 = <0x04 0x08 0x13>;

		apps@0 {
			reg = <0x00>;
			#qcom,smem-state-cells = <0x01>;
			phandle = <0x67>;
		};

		hexagon@1 {
			reg = <0x01>;
			interrupts = <0x00 0x1a 0x01>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
		};

		wcnss@6 {
			reg = <0x06>;
			interrupts = <0x00 0x90 0x01>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
		};
	};

	usb2513 {
		compatible = "smsc,usb3503";
		reset-gpios = <0x81 0x03 0x01>;
		initial-mode = <0x01>;
	};

	usb-id {
		compatible = "linux,extcon-usb-gpio";
		vbus-gpio = <0x26 0x79 0x00>;
		pinctrl-names = "default";
		pinctrl-0 = <0x8e>;
		phandle = <0x46>;
	};

	hdmi-out {
		compatible = "hdmi-connector";
		type = "a";

		port {

			endpoint {
				remote-endpoint = <0x8f>;
				phandle = <0x2f>;
			};
		};
	};

	gpio_keys {
		compatible = "gpio-keys";
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		autorepeat;
		pinctrl-names = "default";
		pinctrl-0 = <0x90>;

		button@0 {
			label = "Volume Up";
			linux,code = <0x73>;
			gpios = <0x26 0x6b 0x01>;
		};
	};
};
