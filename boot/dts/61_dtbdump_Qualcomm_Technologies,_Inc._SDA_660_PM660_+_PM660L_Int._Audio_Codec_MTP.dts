		wake-gic {
			compatible = "qcom,mpm-gic-sdm660\0qcom,mpm-gic";
			interrupts-extended = <0x01 0x00 0xab 0x01>;
			reg = <0x7781b8 0x1000 0x17911008 0x04>;
			reg-names = "vmpm\0ipc";
			qcom,num-mpm-irqs = <0x60>;
			interrupt-controller;
			interrupt-parent = <0x64>;
			#interrupt-cells = <0x03>;
			phandle = <0x01>;
		};

		wake-gpio {
