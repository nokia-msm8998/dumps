				qpnp-labibb-regulator {
					compatible = "qcom,qpnp-labibb-regulator";
					#address-cells = <0x01>;
					#size-cells = <0x01>;
					qcom,pmic-revid = <0x71>;
					qcom,swire-control;
					status = "disabled";

					qcom,ibb@dc00 {
						reg = <0xdc00 0x100>;
