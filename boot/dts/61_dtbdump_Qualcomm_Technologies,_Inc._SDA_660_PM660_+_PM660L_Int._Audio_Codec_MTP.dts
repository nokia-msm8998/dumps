				qpnp-oledb@e000 {
					compatible = "qcom,qpnp-oledb-regulator";
					#address-cells = <0x01>;
					#size-cells = <0x01>;
					qcom,pmic-revid = <0x71>;
					reg = <0xe000 0x100>;
