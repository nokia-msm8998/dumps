			compatible = "qcom,msm-watchdog";
			reg = <0x17817000 0x1000>;
			reg-names = "wdt-base";
			interrupts = <0x00 0x03 0x01 0x00 0x04 0x04>;
			qcom,bark-time = <0x2af8>;
			qcom,pet-time = <0x2710>;
			qcom,ipi-ping;
			qcom,wakeup-enable;
		};

		qcom,sps {
			compatible = "qcom,msm-sps-4k";
