/dts-v1/;

/ {
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	model = "Qualcomm Technologies, Inc. SDA 660 PM660 + PM660L Int. Audio Codec MTP";
	compatible = "qcom,sdm660-mtp\0qcom,sda660\0qcom,mtp";
	qcom,msm-id = <0x144 0x00>;
	interrupt-parent = <0x01>;
	qcom,board-id = <0x200006c 0x00>;
	qcom,pmic-id = <0x1001b 0x101011a 0x00 0x00 0x1001b 0x201011a 0x00 0x00>;

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x00 0x00>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			sched-energy-costs = <0x02>;
			qcom,lmh-dcvs = <0x03>;
			efficiency = <0x400>;
			next-level-cache = <0x04>;
			#cooling-cells = <0x02>;
			phandle = <0x08>;

			l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				qcom,dump-size = <0x00>;
				phandle = <0x04>;
			};

			l1-icache {
				compatible = "arm,arch-cache";
			};

			l1-dcache {
				compatible = "arm,arch-cache";
			};
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x00 0x01>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			sched-energy-costs = <0x02>;
			qcom,lmh-dcvs = <0x03>;
			#cooling-cells = <0x02>;
			efficiency = <0x400>;
			next-level-cache = <0x04>;
			phandle = <0x09>;

			l1-icache {
				compatible = "arm,arch-cache";
			};

			l1-dcache {
				compatible = "arm,arch-cache";
			};
		};

		cpu@2 {
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x00 0x02>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			sched-energy-costs = <0x02>;
			qcom,lmh-dcvs = <0x03>;
			efficiency = <0x400>;
			next-level-cache = <0x04>;
			#cooling-cells = <0x02>;
			phandle = <0x0a>;

			l1-icache {
				compatible = "arm,arch-cache";
			};

			l1-dcache {
				compatible = "arm,arch-cache";
			};
		};

		cpu@3 {
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x00 0x03>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			sched-energy-costs = <0x02>;
			qcom,lmh-dcvs = <0x03>;
			efficiency = <0x400>;
			next-level-cache = <0x04>;
			#cooling-cells = <0x02>;
			phandle = <0x0b>;

			l1-icache {
				compatible = "arm,arch-cache";
			};

			l1-dcache {
				compatible = "arm,arch-cache";
			};
		};

		cpu@100 {
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x00 0x100>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x666>;
			sched-energy-costs = <0x05>;
			qcom,lmh-dcvs = <0x06>;
			efficiency = <0x666>;
			next-level-cache = <0x07>;
			#cooling-cells = <0x02>;
			phandle = <0x0c>;

			l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				phandle = <0x07>;
			};

			l1-icache {
				compatible = "arm,arch-cache";
			};

			l1-dcache {
				compatible = "arm,arch-cache";
			};
		};

		cpu@101 {
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x00 0x101>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x666>;
			sched-energy-costs = <0x05>;
			qcom,lmh-dcvs = <0x06>;
			#cooling-cells = <0x02>;
			efficiency = <0x666>;
			next-level-cache = <0x07>;
			phandle = <0x0d>;

			l1-icache {
				compatible = "arm,arch-cache";
			};

			l1-dcache {
				compatible = "arm,arch-cache";
			};
		};

		cpu@102 {
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x00 0x102>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x666>;
			sched-energy-costs = <0x05>;
			qcom,lmh-dcvs = <0x06>;
			#cooling-cells = <0x02>;
			efficiency = <0x666>;
			next-level-cache = <0x07>;
			phandle = <0x0e>;

			l1-icache {
				compatible = "arm,arch-cache";
			};

			l1-dcache {
				compatible = "arm,arch-cache";
			};
		};

		cpu@103 {
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x00 0x103>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x666>;
			sched-energy-costs = <0x05>;
			qcom,lmh-dcvs = <0x06>;
			#cooling-cells = <0x02>;
			efficiency = <0x666>;
			next-level-cache = <0x07>;
			phandle = <0x0f>;

			l1-icache {
				compatible = "arm,arch-cache";
			};

			l1-dcache {
				compatible = "arm,arch-cache";
			};
		};

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x08>;
				};

				core1 {
					cpu = <0x09>;
				};

				core2 {
					cpu = <0x0a>;
				};

				core3 {
					cpu = <0x0b>;
				};
			};

			cluster1 {

				core0 {
					cpu = <0x0c>;
				};

				core1 {
					cpu = <0x0d>;
				};

				core2 {
					cpu = <0x0e>;
				};

				core3 {
					cpu = <0x0f>;
				};
			};
		};
	};

	soc {
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges = <0x00 0x00 0x00 0xffffffff>;
		compatible = "simple-bus";

		csr@6001000 {
			compatible = "qcom,coresight-csr";
			reg = <0x6001000 0x1000>;
			reg-names = "csr-base";
			coresight-name = "coresight-csr";
			qcom,usb-bam-support;
			qcom,hwctrl-set-support;
			qcom,set-byte-cntr-support;
			qcom,blk-size = <0x01>;
			phandle = <0x10>;
		};

		tmc@6048000 {
			compatible = "arm,primecell";
			arm,primecell-periphid = <0xbb961>;
			reg = <0x6048000 0x1000 0x6064000 0x15000>;
			reg-names = "tmc-base\0bam-base";
			arm,buffer-size = <0x400000>;
			arm,scatter-gather;
			arm,default-sink;
			coresight-csr = <0x10>;
			coresight-ctis = <0x11 0x12>;
			coresight-name = "coresight-tmc-etr";
			clocks = <0x13 0x08 0x13 0x09>;
			clock-names = "apb_pclk\0core_a_clk";

			port {

				endpoint {
					slave-mode;
					remote-endpoint = <0x14>;
					phandle = <0x15>;
				};
			};
		};

		replicator@6046000 {
			compatible = "arm,primecell";
			arm,primecell-periphid = <0xbb909>;
			reg = <0x6046000 0x1000>;
			reg-names = "replicator-base";
			coresight-name = "coresight-replicator-qdss";
			clocks = <0x13 0x08 0x13 0x09>;
			clock-names = "apb_pclk\0core_a_clk";

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@0 {
					reg = <0x00>;

					endpoint {
						remote-endpoint = <0x15>;
						phandle = <0x14>;
					};
				};

				port@1 {
					reg = <0x00>;

					endpoint {
						slave-mode;
						remote-endpoint = <0x16>;
						phandle = <0x17>;
					};
				};
			};
		};

		tmc@6047000 {
			compatible = "arm,primecell";
			arm,primecell-periphid = <0xbb961>;
