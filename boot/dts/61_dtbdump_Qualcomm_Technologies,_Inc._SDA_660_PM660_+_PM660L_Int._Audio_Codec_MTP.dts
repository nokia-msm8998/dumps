			cell-index = <0x01>;
			compatible = "qcom,camera-flash";
			qcom,flash-source = <0x28f>;
			qcom,torch-source = <0x290>;
			qcom,switch-source = <0x291>;
			status = "disabled";
			phandle = <0x1e8>;
		};

		cam_avdd_fixed_regulator {
			compatible = "regulator-fixed";
			regulator-name = "cam_avdd_gpio_regulator";
			regulator-min-microvolt = <0x2ab980>;
			regulator-max-microvolt = <0x2ab980>;
			enable-active-high;
			gpio = <0x292 0x04 0x00>;
			vin-supply = <0x9e>;
			phandle = <0x1ce>;
		};

		cam_actuator_fixed_regulator {
			compatible = "regulator-fixed";
			regulator-name = "cam_actuator_regulator";
			regulator-min-microvolt = <0x36ee80>;
			regulator-max-microvolt = <0x36ee80>;
			enable-active-high;
			gpio = <0x75 0x32 0x00>;
			vin-supply = <0x9e>;
			phandle = <0x1cb>;
		};

		cam_dvdd_fixed_regulator {
			compatible = "regulator-fixed";
			regulator-name = "cam_dvdd_gpio_regulator";
			regulator-min-microvolt = <0x124f80>;
			regulator-max-microvolt = <0x124f80>;
			enable-active-high;
			gpio = <0x292 0x03 0x00>;
			pinctrl-names = "default";
			pinctrl-0 = <0x293>;
			vin-supply = <0x1e9>;
			status = "ok";
			phandle = <0x1d6>;
		};

		cam_rear_dvdd_fixed_regulator {
			compatible = "regulator-fixed";
			regulator-name = "cam_rear_dvdd_gpio_regulator";
			regulator-min-microvolt = <0x124f80>;
			regulator-max-microvolt = <0x124f80>;
			enable-active-high;
			gpio = <0x292 0x05 0x00>;
			pinctrl-names = "default";
			pinctrl-0 = <0x294>;
			vin-supply = <0x1e9>;
			phandle = <0x1cf>;
		};

		qcom,msm-ssc-sensors {
			compatible = "qcom,msm-ssc-sensors";
		};

		max_spkr_pinctrl {
			compatible = "qcom,msm-cdc-pinctrl";
			pinctrl-names = "mi2s_active\0mi2s_sleep";
			pinctrl-0 = <0x295 0x296>;
			pinctrl-1 = <0x297 0x298>;
			qcom,speaker-gpios;
			phandle = <0x181>;
		};

		gpio_keys {
			status = "okay";
			compatible = "gpio-keys";
			label = "gpio-keys";
			virtual-key-code = <0x8f>;
			pinctrl-names = "tlmm_gpio_key_active\0tlmm_gpio_key_suspend";
			pinctrl-0 = <0x299 0x29a>;
			pinctrl-1 = <0x29b 0x29c>;

			right_scan {
				label = "right_scan";
				gpios = <0x75 0x34 0x01>;
				linux,input-type = <0x01>;
				linux,code = <0x105>;
				debounce-interval = <0x01>;
				wakeup-source;
			};

			camera_focus {
				label = "left_scan";
				gpios = <0x75 0x40 0x01>;
				linux,input-type = <0x01>;
				linux,code = <0x101>;
				debounce-interval = <0x0b>;
				wakeup-source;
			};

			vol_up {
				label = "volume_up";
				gpios = <0x292 0x07 0x01>;
				linux,input-type = <0x01>;
				linux,code = <0x73>;
				debounce-interval = <0x0f>;
			};

			scan_handle {
				label = "scan_handle";
				gpios = <0x75 0x4b 0x00>;
				linux,input-type = <0x01>;
				linux,code = <0x106>;
				debounce-interval = <0x0f>;
				wakeup-source;
			};

			push_to_talk {
				label = "push_to_talk";
				gpios = <0x75 0x36 0x01>;
				linux,input-type = <0x01>;
				linux,code = <0x2b1>;
				debounce-interval = <0x0f>;
				wakeup-source;
			};
		};

		gen-vkeys {
			compatible = "qcom,gen-vkeys";
			label = "focaltech";
			qcom,disp-maxx = <0x2d0>;
			qcom,disp-maxy = <0x500>;
			qcom,panel-maxx = <0x2d0>;
			qcom,panel-maxy = <0x6d6>;
			qcom,key-codes = <0x100>;
			qcom,y-offset = <0x0a>;
		};

		dsi_panel_pwr_supply_hx8399 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			phandle = <0x274>;

			qcom,panel-supply-entry@0 {
				reg = <0x00>;
				qcom,supply-name = "wqhd-vddio";
				qcom,supply-min-voltage = <0x1b7740>;
				qcom,supply-max-voltage = <0x1dc130>;
				qcom,supply-enable-load = <0x7d00>;
				qcom,supply-disable-load = <0x50>;
			};

			qcom,panel-supply-entry@1 {
				reg = <0x01>;
				qcom,supply-name = "lab";
				qcom,supply-min-voltage = <0x4630c0>;
				qcom,supply-max-voltage = <0x5b8d80>;
				qcom,supply-enable-load = <0x186a0>;
				qcom,supply-disable-load = <0x64>;
				qcom,supply-pre-on-sleep = <0x01>;
				qcom,supply-post-off-sleep = <0x01>;
			};

			qcom,panel-supply-entry@2 {
				reg = <0x02>;
				qcom,supply-name = "ibb";
				qcom,supply-min-voltage = <0x4630c0>;
				qcom,supply-max-voltage = <0x5b8d80>;
				qcom,supply-enable-load = <0x186a0>;
				qcom,supply-disable-load = <0x64>;
				qcom,supply-pre-on-sleep = <0x01>;
				qcom,supply-post-off-sleep = <0x01>;
			};
		};

		hon-dl3500-dock {
			compatible = "honeywell,hon-dl3500-dock";
			status = "okay";
			hwell,hon-voice-from-dock = <0x00>;
		};

		nordic,nrf52@0 {
			compatible = "nordic,nrf52";
			status = "okay";
			nordic,gpio-vdd-en = <0x75 0x5d 0x00>;
			nordic,gpio-reset = <0x97 0x02 0x00>;
			nordic,gpio-ant-ctrl = <0x75 0x5f 0x00>;
			nordic,gpio-rts-dfu = <0x75 0x0b 0x00>;
			nordic,gpio-cts = <0x75 0x0a 0x00>;
			pinctrl-names = "default";
			pinctrl-0 = <0x29d 0x29e>;
		};

		cam_vaf_fixed_regulator {
			compatible = "regulator-fixed";
			regulator-name = "cam_vaf_gpio_regulator";
			regulator-min-microvolt = <0x2ab980>;
			regulator-max-microvolt = <0x2ab980>;
			enable-active-high;
			gpio = <0x75 0x32 0x00>;
			vin-supply = <0x9e>;
			phandle = <0x1ca>;
		};
	};

	chosen {
		stdout-path = "serial0";
		bootargs = "rcupdate.rcu_expedited=1";
	};

	aliases {
		serial0 = "/soc/serial@0c170000";
		sdhc1 = "/soc/sdhci@c0c4000";
		sdhc2 = "/soc/sdhci@c084000";
		spi1 = "/soc/spi@c175000";
		spi2 = "/soc/spi@c176000";
		spi3 = "/soc/spi@c177000";
		spi4 = "/soc/spi@c178000";
		spi5 = "/soc/spi@c1b5000";
		spi6 = "/soc/spi@c1b6000";
		spi7 = "/soc/spi@c1b7000";
		spi8 = "/soc/spi@c1b8000";
		i2c1 = "/soc/i2c@c175000";
		i2c2 = "/soc/i2c@c176000";
		i2c3 = "/soc/i2c@c177000";
		i2c4 = "/soc/i2c@c178000";
		i2c5 = "/soc/i2c@c1b5000";
		i2c6 = "/soc/i2c@c1b6000";
		i2c7 = "/soc/i2c@c1b7000";
		i2c8 = "/soc/i2c@c1b8000";
		serial1 = "/soc/serial@0c1b0000";
	};

	memory {
		device_type = "memory";
		reg = <0x00 0x00 0x00 0x00>;
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	energy-costs {
		compatible = "sched-energy";

		core-cost0 {
			busy-cost-data = <0x9ab00 0x29 0xdc500 0x46 0x10fe00 0x53 0x156300 0x92 0x177000 0x9e 0x1aa900 0xe4 0x1c2000 0x11d>;
			phandle = <0x02>;
		};

		core-cost1 {
			busy-cost-data = <0x10fe00 0x133 0x156300 0x1e5 0x1aa900 0x359 0x1b8a00 0x373 0x1de200 0x4c6 0x20d000 0x638 0x21b100 0x660 0x258000 0x820>;
			phandle = <0x05>;
		};
	};

	clocks {

		xo_board {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x124f800>;
			clock-output-names = "xo_board";
		};

		sleep_clk {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x7ffc>;
			clock-output-names = "sleep_clk";
		};
	};

