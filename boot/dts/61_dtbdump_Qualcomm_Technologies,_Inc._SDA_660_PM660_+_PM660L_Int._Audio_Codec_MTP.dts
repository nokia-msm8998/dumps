			qcom,q6core-audio {
				compatible = "qcom,q6core-audio";

				sound {
					status = "okay";
					compatible = "qcom,sdm660-asoc-snd";
					qcom,model = "sdm660-snd-card-mtp";
					qcom,mi2s-audio-intf;
					qcom,auxpcm-audio-intf;
					qcom,wcn-btfm;
					qcom,ext-disp-audio-rx;
					qcom,msm-mi2s-master = <0x01 0x01 0x01 0x01 0x01>;
					qcom,msm-mclk-freq = <0x927c00>;
					qcom,msm-mbhc-hphl-swh = <0x01>;
					qcom,msm-mbhc-gnd-swh = <0x01>;
					qcom,msm-micbias2-ext-cap;
					qcom,msm-hs-micbias-type = "external";
					qcom,cdc-pdm-gpios = <0x1f0>;
					qcom,cdc-comp-gpios = <0x1f1>;
					qcom,cdc-dmic-gpios = <0x1f2>;
					qcom,audio-routing = "RX_BIAS\0INT_MCLK0\0SPK_RX_BIAS\0INT_MCLK0\0INT_LDO_H\0INT_MCLK0\0MIC BIAS External\0Handset Mic\0MIC BIAS Internal2\0Headset Mic\0MIC BIAS External\0Secondary Mic\0AMIC1\0MIC BIAS External\0AMIC2\0MIC BIAS Internal2\0AMIC3\0MIC BIAS External\0DMIC1\0MIC BIAS External\0MIC BIAS External\0Digital Mic1\0DMIC3\0MIC BIAS External\0MIC BIAS External\0Digital Mic3\0DMIC4\0MIC BIAS External2\0MIC BIAS External2\0Digital Mic4\0SpkrLeft IN\0SPK1 OUT\0PDM_IN_RX1\0PDM_OUT_RX1\0PDM_IN_RX2\0PDM_OUT_RX2\0PDM_IN_RX3\0PDM_OUT_RX3";
