				anlg-cdc@f000 {
					status = "okay";
					compatible = "qcom,pmic-analog-codec";
					reg = <0xf000 0x200>;
					#address-cells = <0x02>;
					#size-cells = <0x00>;
					interrupt-parent = <0x73>;
					interrupts = <0x03 0xf0 0x00 0x04 0x03 0xf0 0x01 0x04 0x03 0xf0 0x02 0x04 0x03 0xf0 0x03 0x04 0x03 0xf0 0x04 0x04 0x03 0xf0 0x05 0x04 0x03 0xf0 0x06 0x04 0x03 0xf0 0x07 0x04 0x03 0xf1 0x00 0x04 0x03 0xf1 0x01 0x04 0x03 0xf1 0x02 0x04 0x03 0xf1 0x03 0x04 0x03 0xf1 0x04 0x04 0x03 0xf1 0x05 0x04>;
