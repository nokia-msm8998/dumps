	firmware {

		android {
			compatible = "android,firmware";

			fstab {
				compatible = "android,fstab";

				vendor {
					compatible = "android,vendor";
					dev = "/dev/block/platform/soc/c0c4000.sdhci/by-name/vendor";
					type = "ext4";
					mnt_flags = "ro,barrier=1,discard";
					fsmgr_flags = "wait,slotselect,verify";
					status = "ok";
				};
			};
		};
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		wlan_msa_guard@85600000 {
			compatible = "removed-dma-pool";
			no-map;
			reg = <0x00 0x85600000 0x00 0x100000>;
		};

		wlan_msa_mem@85700000 {
			compatible = "removed-dma-pool";
			no-map;
			reg = <0x00 0x85700000 0x00 0x100000>;
			phandle = <0xf4>;
		};

		removed_regions@85800000 {
			compatible = "removed-dma-pool";
			no-map;
			reg = <0x00 0x85800000 0x00 0x800000>;
		};

		smem-mem@86000000 {
			compatible = "removed-dma-pool";
			no-map;
			reg = <0x00 0x86000000 0x00 0x200000>;
			phandle = <0xe3>;
		};

		removed_regions@86200000 {
			compatible = "removed-dma-pool";
			no-map;
			reg = <0x00 0x86200000 0x00 0x2d00000>;
		};

		ramoops_mem@88f00000 {
			compatible = "ramoops";
			reg = <0x00 0x88f00000 0x00 0x100000>;
			console-size = <0x40000>;
		};

		modem_fw_region@8ac00000 {
			compatible = "removed-dma-pool";
			no-map;
			reg = <0x00 0x8ac00000 0x00 0x7e00000>;
			phandle = <0xfd>;
		};

		adsp_fw_region@92a00000 {
			compatible = "removed-dma-pool";
			no-map;
			reg = <0x00 0x92a00000 0x00 0x1e00000>;
			phandle = <0xf7>;
		};

		pil_mba_region@94800000 {
			compatible = "removed-dma-pool";
			no-map;
			reg = <0x00 0x94800000 0x00 0x200000>;
			phandle = <0x100>;
		};

		cdsp_fw_region@94a00000 {
			compatible = "removed-dma-pool";
			no-map;
			reg = <0x00 0x94a00000 0x00 0x600000>;
			phandle = <0xfa>;
		};

		mem_dump_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x1a0000>;
			phandle = <0x77>;
		};

		venus_fw_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x80000000 0x00 0x20000000>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x800000>;
			phandle = <0xef>;
		};

		adsp_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x800000>;
			phandle = <0xdf>;
		};

		qseecom_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x1400000>;
			phandle = <0x107>;
		};

		secure_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x5c00000>;
			phandle = <0x108>;
		};

		linux,cma {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x2c00000>;
			linux,cma-default;
		};

		splash_region@9d400000 {
			reg = <0x00 0x9d400000 0x00 0x2300000>;
			label = "cont_splash_mem";
			phandle = <0x26a>;
		};

		dfps_data_mem@0x9f700000 {
			reg = <0x00 0x9f700000 0x00 0x100000>;
			label = "dfps_data_mem";
			phandle = <0x28b>;
		};
	};

	bt_wcn3990 {
		compatible = "qca,wcn3990";
		qca,bt-vdd-core-supply = <0x29f>;
		qca,bt-vdd-pa-supply = <0x2a0>;
		qca,bt-vdd-ldo-supply = <0x2a1>;
		qca,bt-chip-pwd-supply = <0x2a2>;
