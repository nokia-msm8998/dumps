on post-fs-data && property:ro.hsm.model.num=CK65
	mkdir /data/vendor/touch 0770 system system
	chmod 0664 /sys/bus/i2c/devices/4-004a/cfg_path
	chown system system /sys/bus/i2c/devices/4-004a/cfg_path
        chmod 0664 /sys/bus/i2c/devices/4-004a/cfg_mode
        chown system system /sys/bus/i2c/devices/4-004a/cfg_mode
	start touch_conf_init

on post-fs-data && property:ro.hsm.model.num=CT60
	mkdir /data/vendor/touch 0770 system system
	chmod 0664 /sys/bus/i2c/devices/4-004a/cfg_path
	chown system system /sys/bus/i2c/devices/4-004a/cfg_path
        chmod 0664 /sys/bus/i2c/devices/4-004a/cfg_mode
        chown system system /sys/bus/i2c/devices/4-004a/cfg_mode
	start touch_conf_init

on post-fs-data && property:ro.hsm.model.num=CN80
	mkdir /data/vendor/touch 0770 system system
	chmod 0664 /sys/bus/i2c/devices/4-004a/cfg_path
	chown system system /sys/bus/i2c/devices/4-004a/cfg_path
        chmod 0664 /sys/bus/i2c/devices/4-004a/cfg_mode
        chown system system /sys/bus/i2c/devices/4-004a/cfg_mode
